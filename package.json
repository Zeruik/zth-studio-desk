{
  "name": "zth-design-studio",
  "version": "1.0.0",
  "description": "Offline poster design for studios and clubs / 工作室与社团离线平面设计器",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "build:win": "node scripts/build-windows.cjs",
    "build:portable": "electron-builder --win portable --x64 --publish never",
    "build:web": "node scripts/build-web.cjs",
    "build:android": "bash android/build.sh",
    "package:win": "electron-builder --win --x64 --dir --publish never"
  },
  "keywords": [],
  "author": "理工阿白菌 / TechABJ · ZeroToHand Studio",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.12",
    "fabric": "^6.9.0",
    "jspdf": "^3.0.4",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^5.4.394",
    "qrcode": "^1.5.4"
  },
  "build": {
    "appId": "studio.zerotohand.design",
    "productName": "ZTH Design Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "app/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "name": "zth-design-studio"
    },
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false,
      "artifactName": "ZTH-Design-Studio-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ZTH-平面设计器",
      "license": "build/license.txt",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "displayLanguageSelector": true
    },
    "fileAssociations": []
  }
}
